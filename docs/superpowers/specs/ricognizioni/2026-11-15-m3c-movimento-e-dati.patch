@@ -0,0 +1,31 @@
+package com.toxineren.exoframes.mixin;
+
+import com.toxineren.exoframes.frame.SuitMovement;
+import net.minecraft.world.entity.player.Player;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/**
+ * RICOGNIZIONE 3c: la tuta in acqua (design 5.6). Tre metodi di {@code Player} con la stessa firma sulle due versioni e
+ * sui tre loader (javap): nessuna direttiva, elencato nella sezione {@code mixins} delle due configurazioni.
+ */
+@Mixin(Player.class)
+abstract class PlayerMovementMixin {
+    @Inject(method = "isAffectedByFluids()Z", at = @At("RETURN"), cancellable = true)
+    private void exoframes$suitIgnoresWater(CallbackInfoReturnable<Boolean> cir) {
+        cir.setReturnValue(SuitMovement.affectedByFluids((Player) (Object) this, cir.getReturnValueZ()));
+    }
+
+    @Inject(method = "isPushedByFluid()Z", at = @At("RETURN"), cancellable = true)
+    private void exoframes$suitNotPushed(CallbackInfoReturnable<Boolean> cir) {
+        cir.setReturnValue(SuitMovement.pushedByFluid((Player) (Object) this, cir.getReturnValueZ()));
+    }
+
+    @Inject(method = "updateSwimming()V", at = @At("TAIL"))
+    private void exoframes$suitNeverSwims(CallbackInfo ci) {
+        SuitMovement.afterUpdateSwimming((Player) (Object) this);
+    }
+}
diff --git a/src/main/java/com/toxineren/exoframes/mixin/client/LocalPlayerSprintMixin.java b/src/main/java/com/toxineren/exoframes/mixin/client/LocalPlayerSprintMixin.java
new file mode 100644
