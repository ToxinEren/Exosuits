+++ b/src/main/java/com/toxineren/exoframes/frame/SuitMovement.java
@@ -0,0 +1,54 @@
+package com.toxineren.exoframes.frame;
+
+import com.toxineren.exoframes.compat.Compat;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.Items;
+
+/**
+ * RICOGNIZIONE 3c (esperimento, non per main): movimento di chi indossa la tuta.
+ * <ul>
+ * <li>(a) in acqua niente fisica dei fluidi: si cade, si cammina e non si salta, niente nuoto, niente corrente;</li>
+ * <li>(b) passo di un blocco;</li>
+ * <li>(c) scatto spento con "energia bassa" (qui simulata: polvere di redstone nella mano secondaria).</li>
+ * </ul>
+ * Codice comune, chiamato dai mixin (una chiamata per aggancio) e dal tick del giocatore sui due lati.
+ */
+public final class SuitMovement {
+    private SuitMovement() {
+    }
+
+    /** {@code Player.isAffectedByFluids()}: falso per la tuta che tocca l'acqua (non la lava). */
+    public static boolean affectedByFluids(Player player, boolean vanilla) {
+        return vanilla && !(SuitSize.wearsSuit(player) && player.isInWater() && !player.isInLava());
+    }
+
+    /** {@code Player.isPushedByFluid()}: la corrente non sposta la tuta. */
+    public static boolean pushedByFluid(Player player, boolean vanilla) {
+        return vanilla && !SuitSize.wearsSuit(player);
+    }
+
+    /** In coda a {@code Player.updateSwimming()}: la tuta non nuota mai. */
+    public static void afterUpdateSwimming(Player player) {
+        if (player.isSwimming() && SuitSize.wearsSuit(player)) {
+            player.setSwimming(false);
+        }
+    }
+
+    /** {@code LocalPlayer.hasEnoughFoodToStartSprinting()} (client): niente scatto con l'energia bassa. */
+    public static boolean sprintAllowed(Player player, boolean vanilla) {
+        return vanilla && !lowEnergy(player);
+    }
+
+    /** Segnaposto dell'energia sotto il 10 %: tuta indossata e polvere di redstone nella mano secondaria. */
+    static boolean lowEnergy(Player player) {
+        return SuitSize.wearsSuit(player) && player.getOffhandItem().is(Items.REDSTONE);
+    }
+
+    /** {@code TickEvent.PLAYER_PRE}, sui due lati. */
+    public static void tick(Player player) {
+        Compat.attributes().stepUp(player, SuitSize.wearsSuit(player));
+        if (!player.level().isClientSide && player.isSprinting() && lowEnergy(player)) {
+            player.setSprinting(false);
+        }
+    }
+}
diff --git a/src/main/java/com/toxineren/exoframes/mixin/PlayerMovementMixin.java b/src/main/java/com/toxineren/exoframes/mixin/PlayerMovementMixin.java
