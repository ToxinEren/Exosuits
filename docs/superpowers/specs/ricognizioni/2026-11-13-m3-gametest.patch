@@ -69,6 +69,39 @@ repositories {
     maven("https://repo.maven.apache.org/maven2/") { name = "MavenCentralFallback" }
 }
 
+// SPIKE: server GameTest headless, un task per variante (runGameTestServer), cartella versions/<variante>/run.
+// Il server esce con System.exit(numero di test obbligatori falliti), quindi il JavaExec fallisce se un test fallisce.
+loom {
+    runs {
+        create("gameTestServer") {
+            server()
+            name("GameTest Server")
+            ideConfigGenerated(false)
+            when (loader) {
+                "fabric" -> {
+                    property("fabric-api.gametest")
+                    property("fabric-api.gametest.report-file", project.layout.buildDirectory.file("gametest/report.xml").get().asFile.absolutePath)
+                }
+                "forge" -> {
+                    forgeTemplate("gameTestServer")
+                    property("forge.enabledGameTestNamespaces", project.property("mod.id").toString())
+                    // server() impone il launch target forgeserveruserdev (il template forgegametestserveruserdev non
+                    // passa): senza questa proprieta' parte un server normale, che senza eula esce con 0 e zero test
+                    property("forge.enableGameTest", "true")
+                    property("forge.gameTestServer", "true")
+                }
+                "neoforge" -> {
+                    forgeTemplate("gameTestServer")
+                    property("neoforge.enabledGameTestNamespaces", project.property("mod.id").toString())
+                    // il template di userdev non arriva al task di Loom: senza questa proprieta' parte un server normale
+                    property("neoforge.enableGameTest", "true")
+                    property("neoforge.gameTestServer", "true")
+                }
+            }
+        }
+    }
+}
+
 dependencies {
     minecraft("com.mojang:minecraft:$mc")
     mappings(loom.officialMojangMappings())
diff --git a/src/main/java/com/toxineren/exoframes/gametest/ExoframesGameTests.java b/src/main/java/com/toxineren/exoframes/gametest/ExoframesGameTests.java
new file mode 100644
index 0000000..68ee633
--- /dev/null
+++ b/src/main/java/com/toxineren/exoframes/gametest/ExoframesGameTests.java
@@ -0,0 +1,70 @@
+package com.toxineren.exoframes.gametest;
+
+import com.toxineren.exoframes.compat.Compat;
+import com.toxineren.exoframes.core.frame.FrameState;
+import com.toxineren.exoframes.platform.GameTestPlayers;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.function.Consumer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.gametest.framework.GameTestGenerator;
+import net.minecraft.gametest.framework.GameTestHelper;
+import net.minecraft.gametest.framework.TestFunction;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.level.block.Blocks;
+
+/**
+ * SPIKE: GameTest in gioco condivisi dalle quattro varianti, senza direttive Stonecutter. I test sono prodotti da
+ * un {@link GameTestGenerator} con il costruttore a 7 argomenti di {@link TestFunction}, identico su 1.20.1 e
+ * 1.21.1, cosi' nome della struttura e namespace sono espliciti e uguali su tutti i loader. Registrazione: su Fabric
+ * l'entrypoint {@code fabric-gametest} (fabric.mod.json) punta a questa classe (serve il costruttore pubblico); su
+ * Forge e NeoForge l'entrypoint in platform/ la registra con {@code RegisterGameTestsEvent}.
+ */
+public final class ExoframesGameTests {
+    /** Struttura vuota 8x8x8 fornita dalla mod: data/redstone_exoframes/structure(s)/empty.nbt. */
+    public static final String EMPTY_STRUCTURE = "redstone_exoframes:empty";
+
+    public static final String NAMESPACE = "redstone_exoframes";
+
+    public ExoframesGameTests() {
+    }
+
+    @GameTestGenerator
+    public static Collection<TestFunction> generate() {
+        List<TestFunction> functions = new ArrayList<>();
+        // nome con namespace: Forge 1.20.1 filtra i test generati per namespace del nome, NeoForge per quello della struttura
+        all().forEach((name, test) -> functions.add(
+                new TestFunction(NAMESPACE, NAMESPACE + ":" + name, EMPTY_STRUCTURE, 100, 0L, true, test)));
+        return functions;
+    }
+
+    /** I test, per nome (senza namespace), nell'ordine di esecuzione. */
+    public static Map<String, Consumer<GameTestHelper>> all() {
+        Map<String, Consumer<GameTestHelper>> tests = new LinkedHashMap<>();
+        tests.put("trivial_block", ExoframesGameTests::trivialBlock);
+        tests.put("frame_state_mock_player", ExoframesGameTests::frameStateMockPlayer);
+        return tests;
+    }
+
+    /** Prova del cablaggio: piazza un blocco e verifica che ci sia. */
+    public static void trivialBlock(GameTestHelper helper) {
+        BlockPos pos = new BlockPos(1, 1, 1);
+        helper.setBlock(pos, Blocks.REDSTONE_BLOCK);
+        helper.assertBlockPresent(Blocks.REDSTONE_BLOCK, pos);
+        helper.succeed();
+    }
+
+    /** Stato del telaio per giocatore su un giocatore finto: update, poi get. */
+    public static void frameStateMockPlayer(GameTestHelper helper) {
+        ServerPlayer player = GameTestPlayers.mockServerPlayer(helper);
+        Compat.frameState().update(player, state -> state.setReinforced(true));
+        Optional<FrameState> state = Compat.frameState().get(player);
+        helper.assertTrue(state.isPresent(), "frame state missing after update");
+        helper.assertTrue(state.get().reinforced(), "frame state not reinforced after update");
+        helper.succeed();
+    }
+}
