+package com.toxineren.exoframes.frame;
+
+import com.google.common.collect.MapMaker;
+import com.toxineren.exoframes.content.ModItems;
+import java.util.concurrent.ConcurrentMap;
+import net.minecraft.world.entity.EntityDimensions;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.entity.Pose;
+import net.minecraft.world.entity.player.Player;
+
+/**
+ * SPIKE (ricognizione grandezza reale): ingombro e altezza degli occhi di chi indossa la tuta, sui due lati.
+ * Codice comune, senza direttive: i due mixin per versione chiamano solo questi metodi.
+ */
+public final class SuitSize {
+    /** Scala verticale: quella del disegno (client/SuitScale.S, che qui non si puo' importare: e' codice client). */
+    public static final float HEIGHT_SCALE = 1.65f;
+    /** Larghezza 0,8: passa i 13/16 lasciati da scala a pioli, porta aperta, botola aperta. */
+    public static final float WIDTH_SCALE = 0.8f / 0.6f;
+
+    /** Ultimo stato visto per giocatore, per lato; chiavi deboli per identita' (MapMaker.weakKeys). */
+    private static final ConcurrentMap<Player, Boolean> SEEN = new MapMaker().weakKeys().makeMap();
+
+    private SuitSize() {
+    }
+
+    /** Vero se il giocatore ha il segnaposto del torso nello slot. Sicuro anche dentro il costruttore di Entity. */
+    public static boolean wearsSuit(Player player) {
+        if (player.getInventory() == null || !ModItems.EXOFRAME_TORSO.isPresent()) {
+            return false; // Entity.<init> chiama getDimensions prima che Player abbia l'inventario
+        }
+        return player.getItemBySlot(EquipmentSlot.CHEST).is(ModItems.EXOFRAME_TORSO.get());
+    }
+
+    /** Ingombro per la posa: quello vanilla scalato; le dimensioni fisse (sonno, morte) restano come sono. */
+    public static EntityDimensions dimensions(Player player, Pose pose, EntityDimensions vanilla) {
+        return wearsSuit(player) ? vanilla.scale(WIDTH_SCALE, HEIGHT_SCALE) : vanilla;
+    }
+
+    /** Solo 1.20.1: altezza degli occhi per la posa (su 1.21.1 sta dentro EntityDimensions). */
+    public static float eyeHeight(Player player, Pose pose, float vanilla) {
+        return wearsSuit(player) ? vanilla * HEIGHT_SCALE : vanilla;
+    }
+
+    /** A ogni tick di ogni giocatore, sui due lati (TickEvent.PLAYER_PRE): ricalcola l'ingombro quando cambia. */
+    public static void tick(Player player) {
+        boolean now = wearsSuit(player);
+        Boolean before = SEEN.put(player, now);
+        if (before == null ? now : before != now) {
+            player.refreshDimensions();
+            com.toxineren.exoframes.RedstoneExoframes.LOGGER.info("SPIKE refresh client={} player={} suited={} w={} h={} eye={}",
+                    player.level().isClientSide, player.getGameProfile().getName(), now, player.getBbWidth(),
+                    player.getBbHeight(), player.getEyeHeight());
+        }
+    }
+}
