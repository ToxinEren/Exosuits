@@ -379,6 +381,72 @@ public final class ExoframeGameTests {
      * Aggiunge un test obbligatorio nella struttura vuota. Il nome {@code temaCaso} diventa
      * {@code redstone_exoframes:tema_caso}: Forge lo legge come ResourceLocation, che non ammette maiuscole.
      */
+    // --- SPIKE grandezza reale ---
+
+    private static String size(ServerPlayer p) {
+        return String.format(Locale.ROOT, "pose=%s w=%.4f h=%.4f eye=%.4f crouchEye=%.4f", p.getPose(), p.getBbWidth(),
+                p.getBbHeight(), p.getEyeHeight(), p.getEyeHeight(net.minecraft.world.entity.Pose.CROUCHING));
+    }
+
+    private static boolean near(float a, float b) {
+        return Math.abs(a - b) < 1e-3f;
+    }
+
+    /** Il segnaposto del torso fa crescere ingombro e occhi sul server; toglierlo li riporta a quelli vanilla. */
+    private static void spikeSuitGrowsBoxAndEyes(GameTestHelper helper) {
+        ServerPlayer player = Compat.gameTests().mockServerPlayer(helper);
+        com.toxineren.exoframes.frame.SuitSize.tick(player);
+        String before = size(player);
+        helper.assertTrue(near(player.getBbHeight(), 1.8f) && near(player.getEyeHeight(), 1.62f), "vanilla: " + before);
+
+        DebugWear.wear(player, SuitSummary.BARE);
+        String afterWearNoTick = size(player);
+        com.toxineren.exoframes.frame.SuitSize.tick(player);
+        String suited = size(player);
+        RedstoneExoframes.LOGGER.info("SPIKE size before={} | wear,no refresh={} | suited={}", before, afterWearNoTick,
+                suited);
+        helper.assertTrue(near(player.getBbHeight(), 1.8f * 1.65f), "suited height: " + suited);
+        helper.assertTrue(near(player.getBbWidth(), 0.8f), "suited width: " + suited);
+        helper.assertTrue(near(player.getEyeHeight(), 1.62f * 1.65f), "suited eyes: " + suited);
+        helper.assertTrue(near(player.getEyeHeight(net.minecraft.world.entity.Pose.CROUCHING), 1.27f * 1.65f),
+                "suited crouch eyes: " + suited);
+        helper.assertTrue(near((float) (player.getBoundingBox().maxY - player.getY()), 1.8f * 1.65f),
+                "bounding box not rebuilt: " + suited);
+
+        DebugWear.remove(player);
+        com.toxineren.exoframes.frame.SuitSize.tick(player);
+        String after = size(player);
+        RedstoneExoframes.LOGGER.info("SPIKE size after remove={}", after);
+        helper.assertTrue(near(player.getBbHeight(), 1.8f) && near(player.getEyeHeight(), 1.62f), "removed: " + after);
+        helper.succeed();
+    }
+
+    /** In uno spazio alto 2 la tuta non sta in piedi ne' accovacciata: il gioco la mette a carponi da solo. */
+    private static void spikeSuitCrawlsUnderLowCeiling(GameTestHelper helper) {
+        ServerPlayer player = Compat.gameTests().mockServerPlayer(helper);
+        for (int x = 2; x <= 6; x++) {
+            for (int z = 2; z <= 6; z++) {
+                helper.setBlock(new BlockPos(x, 1, z), Blocks.STONE);
+                helper.setBlock(new BlockPos(x, 4, z), Blocks.STONE);
+            }
+        }
+        net.minecraft.world.phys.Vec3 feet = helper.absoluteVec(new net.minecraft.world.phys.Vec3(4.5, 2.0, 4.5));
+        player.moveTo(feet.x, feet.y, feet.z, 0f, 0f);
+        player.doTick();
+        String plain = size(player);
+        helper.assertTrue(player.getPose() == net.minecraft.world.entity.Pose.STANDING, "plain player: " + plain);
+
+        DebugWear.wear(player, SuitSummary.BARE);
+        player.doTick(); // PLAYER_PRE: refresh (2,97, nel soffitto), poi updatePlayerPose
+        String first = size(player);
+        player.doTick();
+        String second = size(player);
+        RedstoneExoframes.LOGGER.info("SPIKE low ceiling plain={} | tick1={} | tick2={}", plain, first, second);
+        helper.assertTrue(player.getPose() == net.minecraft.world.entity.Pose.SWIMMING, "suited under 2: " + second);
+        helper.assertTrue(near(player.getBbHeight(), 0.6f * 1.65f), "crawl box: " + second);
+        helper.succeed();
+    }
+
     private static void add(List<TestFunction> tests, String name, Consumer<GameTestHelper> test) {
         String id = RedstoneExoframes.MOD_ID + ":" + name.replaceAll("([A-Z])", "_$1").toLowerCase(Locale.ROOT);
         tests.add(new TestFunction(RedstoneExoframes.MOD_ID, id, EMPTY_STRUCTURE, MAX_TICKS, 0L, true, test));
diff --git a/src/main/java/com/toxineren/exoframes/mixin/PlayerSize120Mixin.java b/src/main/java/com/toxineren/exoframes/mixin/PlayerSize120Mixin.java
